# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Random string, 32+ chars. Signs access-code hashes. Changing it invalidates
# every member access code, so generate once and keep it.
#   openssl rand -base64 48
SESSION_SECRET=

# The code you type at /admin/login to claim/enter the admin account.
# Never stored in the database.
ADMIN_REG_CODE=

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------

# Bearer token for POST /api/payments/ingest and POST /api/storage/update.
INGEST_TOKEN=

# Bearer token for POST /api/cron/daily (external scheduler).
CRON_SECRET=

# Canonical public URL. Leave blank to follow X-Forwarded-* headers from your
# reverse proxy. Set it when invite links must always use one domain.
APP_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# IANA timezone used for "today", due dates and digests.
APP_TIMEZONE=UTC

# Where SQLite lives. /data is the mounted volume in docker-compose.
DATA_DIR=/data
DATABASE_PATH=/data/applecare.db

# Run the reminder/digest/storage job inside the container every 6 hours.
# Safe to enable alongside an external cron: work is deduplicated.
INTERNAL_SCHEDULER=false

# Force cookie security when TLS terminates upstream and headers are missing.
# true | false | unset (auto-detect from APP_URL / X-Forwarded-Proto)
COOKIE_SECURE=

# Last-resort USD->CNY rate when the FX provider is unreachable and no cached
# rate exists yet.
FX_FALLBACK_RATE=7.2
